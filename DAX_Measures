# DAX Measures

## Total Revenue
```DAX
TOTAL REVENUE =
SUM(Sales[Sales Amount])

TOTAL PROFIT =
SUM(Sales[Sales Amount]) -
SUM(Sales[Total Product Cost])

PROFIT MARGIN =
DIVIDE(
    [TOTAL PROFIT],
    [TOTAL REVENUE],
    0
)

TOTAL ORDERS =
DISTINCTCOUNT(Sales[SalesOrderLineKey])

UNITS SOLD =
SUM(Sales[Order Quantity])

AVG ORDER VALUE =
DIVIDE(
    [TOTAL REVENUE],
    [TOTAL ORDERS],
    0
)

Revenue KPI Text =
VAR LatestFY = 2020
VAR CurrentRevenue =
    CALCULATE(
        [TOTAL REVENUE],
        FILTER(ALL('Date'), VALUE(RIGHT('Date'[Fiscal Year], 4)) = LatestFY)
    )
VAR PreviousRevenue =
    CALCULATE(
        [TOTAL REVENUE],
        FILTER(ALL('Date'), VALUE(RIGHT('Date'[Fiscal Year], 4)) = LatestFY - 1)
    )
VAR Growth =
    DIVIDE(CurrentRevenue - PreviousRevenue, PreviousRevenue)
RETURN
IF(
    Growth >= 0,
    "▲ " & FORMAT(Growth, "0.0%") & " YoY",
    "▼ " & FORMAT(ABS(Growth), "0.0%") & " YoY"
)

